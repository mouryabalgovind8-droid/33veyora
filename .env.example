# Database (PostgreSQL)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-password
PG_DATABASE=33veyora

# Legacy (older sql.js setup - kept for compatibility)
DATABASE_URL=./database/database.db

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Server
BACKEND_PORT=3001
FRONTEND_PORT=5173

# CORS
FRONTEND_URL=http://localhost:5173

# Email (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Gemini AI (optional)
GEMINI_API_KEY=your-gemini-api-key

# OAuth (Google & Facebook) - used by frontend/.env
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_FACEBOOK_APP_ID=your-facebook-app-id

# Payment Gateways (for production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Cloudinary (image uploads go to the cloud — required for photo upload)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-numeric-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Alternative: single URL — CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
